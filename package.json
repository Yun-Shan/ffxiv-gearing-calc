{
  "name": "ffxiv-gearing-calc",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:domain:coverage": "vitest run --config vitest.domain.config.ts --coverage",
    "data:update": "node scripts/update-data.mjs",
    "data:format": "node scripts/describe-binary-format.mjs",
    "data:format:check": "node scripts/describe-binary-format.mjs --check",
    "data:benchmark": "node --expose-gc scripts/benchmark-data-binary.mjs",
    "test:data": "node --test --test-concurrency=2 scripts/node-tests/mcp-query-validation.test.mjs scripts/node-tests/mcp-query-presets.test.mjs scripts/node-tests/mcp-lumina-query.test.mjs scripts/node-tests/mcp-weapon-damage.test.mjs scripts/node-tests/gear-catalog-policy.test.mjs scripts/node-tests/sync-level-duties.test.mjs scripts/node-tests/bin-ui-metadata.test.mjs scripts/node-tests/data-update.test.mjs scripts/node-tests/data-update-modules.test.mjs && vitest run src/data/binary/codec.test.ts",
    "test:v3:runner": "node --test scripts/node-tests/run-v3.test.mjs",
    "data:test:v3": "node --max-old-space-size=2560 --experimental-strip-types scripts/node-tests/run-v3.mjs"
  },
  "dependencies": {
    "@base-ui/react": "^1.9.0",
    "fast-json-stable-stringify": "^2.1.0",
    "highs": "^1.15.3",
    "lucide-react": "^1.41.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@babel/parser": "^7.29.8",
    "@playwright/test": "^1.63.0",
    "@types/node": "^26.4.1",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "@vitest/coverage-v8": "^5.0.0",
    "jsdom": "^30.0.1",
    "prettier": "^3.9.6",
    "sass": "^1.105.1",
    "sharp": "^0.35.5",
    "sharp-ico": "^0.1.5",
    "typescript": "^7.0.2",
    "vite": "^8.2.2",
    "vitest": "^5.0.0"
  }
}
